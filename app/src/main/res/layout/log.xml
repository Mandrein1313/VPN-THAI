<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:padding="16dp">

    <!-- หัวข้อ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ไฟล์บันทึก VPN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingBottom="4dp" />

    <!-- สถานะ (OpenVPN / WireGuard) -->
    <TextView
        android:id="@+id/log_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="สถานะ: กำลังโหลด..."
        android:textSize="14sp"
        android:textColor="#757575"
        android:paddingBottom="12dp" />

    <!-- เส้นคั่น -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <!-- พื้นที่แสดง Log -->
    <ScrollView
        android:id="@+id/log_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:background="#FFFFFF"
        android:padding="12dp">

        <TextView
            android:id="@+id/log_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#424242"
            android:lineSpacingExtra="2dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- ปุ่มด้านล่าง -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/log_pause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="หยุด"
            android:textAllCaps="false"
            android:backgroundTint="#5C6BC0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/log_resume"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="ดำเนินการต่อ"
            android:textAllCaps="false"
            android:visibility="gone"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/log_clear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="ล้าง"
            android:textAllCaps="false"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>